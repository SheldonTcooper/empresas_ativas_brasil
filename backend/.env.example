# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Banco de dados PostgreSQL ─────────────────────────────────────────────────
# Formato: postgresql://usuario:senha@host:porta/banco
DATABASE_URL=postgresql://empresas:SUA_SENHA_AQUI@localhost:5432/cnpj_rf

# Use DATABASE_SSL=true se PostgreSQL estiver em servidor remoto com SSL
DATABASE_SSL=false

# ── Groq AI (obtenha em console.groq.com — gratuito) ─────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── CORS (domínio(s) do frontend, separados por vírgula) ─────────────────────
# Use * para permitir qualquer origem (não recomendado em produção)
CORS_ORIGIN=https://empresasativasbr.com.br,https://www.empresasativasbr.com.br

# Rate limit por IP (padrões: 120 req/min na API, 30 análises de IA por hora)
RATE_LIMIT_POR_MINUTO=120
RATE_LIMIT_IA_POR_HORA=30

# Endereço público do site (canonical, sitemap)
SITE_URL=https://www.empresasativas.online

# Responsável e contato exibidos em /privacidade e /termos (LGPD)
# Ex.: SITE_RESPONSAVEL="Empresa Exemplo Ltda (CNPJ 00.000.000/0001-00)"
SITE_RESPONSAVEL=
SITE_EMAIL_CONTATO=
